# Which source to use: cheapshark (no key needed) | bestbuy | ebay
PRICE_PROVIDER=cheapshark

# Best Buy: https://developer.bestbuy.com  (free API key, sent by email)
BESTBUY_API_KEY=

# eBay Developer Program: https://developer.ebay.com  (Application Keys -> Production)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=production          # production | sandbox
EBAY_MARKETPLACE=EBAY_US     # EBAY_US, EBAY_GB, EBAY_DE ...

# Scheduled ingestion
SCHEDULER_ENABLED=true
INGEST_INTERVAL_MINUTES=360

# Database (for local run outside Docker)
POSTGRES_USER=price_user
POSTGRES_PASSWORD=price_pass
POSTGRES_DB=price_intelligence
DATABASE_URL=postgresql+psycopg2://price_user:price_pass@localhost:5432/price_intelligence
